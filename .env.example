# Obavezno (Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Opciono: slanje faktura mejlom preko tvog Gmail naloga (besplatno)
# Potrebna je "App password" (Google nalog -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=tvoj.mejl@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Dozvoli slanje samo tvom nalogu (mejl kojim se prijavljuješ u aplikaciju)
OWNER_EMAIL=tvoj.mejl@gmail.com
